<Window x:Class="JunctionManager.NewJunctionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New junction" Width="490" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
    Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <StackPanel Margin="18,14">
    <TextBlock Text="Name (optional)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
    <TextBox x:Name="NameBox" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="10,0"/>

    <TextBlock Text="Source: where the app expects the folder (junction link)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SrcBox" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="10,0"/>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="8,0,0,0" Click="BrowseSrc_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0">
            <Path Data="M2,7 A2,2 0 0,1 4,5 H8 L10,7 H18 A2,2 0 0,1 20,9 M2,10 H22 L20,20 H4 L2,10 Z"
                  Stroke="{DynamicResource Text}" StrokeThickness="1.5" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock Text="Browse" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock Text="Target: where the real files live (storage location)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="TgtBox" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="10,0"/>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="8,0,0,0" Click="BrowseTgt_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0">
            <Path Data="M2,7 A2,2 0 0,1 4,5 H8 L10,7 H18 A2,2 0 0,1 20,9 M2,10 H22 L20,20 H4 L2,10 Z"
                  Stroke="{DynamicResource Text}" StrokeThickness="1.5" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock Text="Browse" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <CheckBox x:Name="WatchBox" Style="{StaticResource Switch}" Content="Watch and auto-repair after updates" IsChecked="False" Margin="0,12,0,0"/>
    <CheckBox x:Name="HideBox" Style="{StaticResource Switch}" Content="Make the target folder hidden" Margin="0,8,0,0"/>
    <CheckBox x:Name="ProtBox" Style="{StaticResource Switch}" Content="Protect target folder from deletion" Margin="0,8,0,0"/>

    <TextBlock x:Name="Err" Foreground="#F85149" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0" IsCancel="True" Margin="0,0,8,0"/>
      <Button Style="{StaticResource AccentButton}" Height="30" Padding="16,0" IsDefault="True" Click="Create_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="12" Height="12" Margin="0,0,6,0">
            <Path Data="M12,4 V20 M4,12 H20" Stroke="White" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock Text="Create" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
