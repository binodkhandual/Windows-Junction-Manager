<Window x:Class="JunctionManager.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About Junction Manager" Width="580" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
    Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <StackPanel Margin="22,18">
    <!-- App Logo & Identity (Compact) -->
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="50" Height="50" CornerRadius="12" Background="{DynamicResource Card}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,14,0"
              VerticalAlignment="Center">
        <Image Source="app.png" Width="38" Height="38" VerticalAlignment="Center" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Junction Manager" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                  CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Text="v2.1.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Created by biN32  •  Lightweight NTFS Junction Tool for Windows" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Description Card -->
    <Border Padding="12" Background="{DynamicResource Card}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="About the App" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text}" LineHeight="17" FontSize="12">
          Junction Manager lets you effortlessly create, monitor, and manage NTFS folder junctions. Seamlessly redirect storage-heavy directories (such as AppData, game folders, caches, and dev libraries) to another drive while keeping original file paths intact for Windows and apps.
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Key Features Card with ScrollViewer -->
    <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource Card}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Key Features" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>
        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <StackPanel>
            <TextBlock Text="• Real-Time Search Filter: Instantly search and filter junctions across names, link paths, and storage targets from the top navigation bar."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Two-Stage Junction Scanner: Scan directories with system junction filtering, preview discovered junctions in a selective checklist dialog with header toggle, and import only checked entries."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• In-App Toast Notifications: Non-intrusive auto-dismissing toast alerts for refresh, repairs, and status updates instead of blocking modal popups."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• One-Click List Clear: Easily clear the grid and config from the main window without manually finding or deleting ini files."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Target Data Protection &amp; Stealth: Prevent accidental deletion of real folders via ACL locks, and optionally hide them in File Explorer."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Automatic Background Auto-Repair: Continuously watches parent folders to automatically restore junctions overwritten by software updates."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Integrated File Migration: Built-in multi-threaded Robocopy safely moves data to the target before creating the junction."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Per-Row Controls &amp; Untrack (×): Instantly toggle stealth/lock (with rectangle hover and action toasts), repair links, explore targets, untrack from list (×) without touching disk files, or delete junction links."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• System Tray Minimization: Keep monitoring active junctions silently in the background via the Windows notification area."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Dynamic Theming: Live switching between System default, Dark, and Light modes with theme-aligned tooltips and controls."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" LineHeight="16"/>
            <TextBlock Text="• Zero-Bloat Performance: Lightweight native single-file Windows executable under 1 MB with minimal memory footprint."
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" LineHeight="16"/>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Footer & Close Button -->
    <Grid Margin="0,14,0,0">
      <TextBlock Text="Config: %LocalAppData%\JunctionManager" Foreground="{DynamicResource Muted}"
                 FontSize="11" VerticalAlignment="Center"/>
      <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0"
              HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="Close_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="11" Height="11" Margin="0,0,6,0">
            <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{DynamicResource Text}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock Text="Close" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</Window>
