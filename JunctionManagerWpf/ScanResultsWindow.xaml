<Window x:Class="JunctionManager.ScanResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Discovered Junctions" Width="760" Height="480" MinWidth="600" MinHeight="360"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
    Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Card}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,0"
              VerticalAlignment="Center">
        <Viewbox Width="22" Height="22">
          <Path Data="M9,11 L12,14 L22,4 M21,12 V19 A2,2 0 0,1 19,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H16"
                Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderTitle" Text="Discovered Junctions" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="HeaderSubtitle" Text="Select the discovered junctions you want to import into Junction Manager."
                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Column Headers -->
    <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" CornerRadius="6,6,0,0" Padding="12,8" Margin="0,0,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="SelectAllHeaderBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsThreeState="True" IsChecked="True" ToolTip="Select / Deselect all" Click="SelectAll_Click"/>
        <TextBlock Grid.Column="1" Text="Name" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="Source (link)" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="Target (real folder)" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="Status" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Junction Items List -->
    <Border Grid.Row="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
      <ListBox x:Name="DiscoveredList" Background="Transparent" BorderThickness="0" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource CardHover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SelectedRowBg}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="ItemCheck_Click"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="2" Text="{Binding Source}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Source}"/>
              <TextBlock Grid.Column="3" Text="{Binding Target}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Target}"/>
              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Status}" FontSize="11"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Bottom Actions -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="SelectedCountText" Text="0 selected" Foreground="{DynamicResource Muted}"
                 FontSize="12" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0"
                IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button x:Name="ImportButton" Style="{StaticResource AccentButton}" Height="30" Padding="16,0"
                IsDefault="True" Click="Import_Click">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
              <Path Data="M12,4 V16 M6,10 L12,16 L18,10 M4,20 H20" Stroke="White" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock x:Name="ImportButtonText" Text="Import Selected" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
