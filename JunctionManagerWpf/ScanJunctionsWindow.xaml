<Window x:Class="JunctionManager.ScanJunctionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scan for existing junctions" Width="520" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
    Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
  <StackPanel Margin="20,16">
    <!-- Header -->
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Card}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,0"
              VerticalAlignment="Center">
        <Viewbox Width="22" Height="22">
          <Path Data="M3,7 V5 A2,2 0 0,1 5,3 H7 M17,3 H19 A2,2 0 0,1 21,5 V7 M21,17 V19 A2,2 0 0,1 19,21 H17 M7,21 H5 A2,2 0 0,1 3,19 V17 M10,10 A3,3 0 1,0 10,16 A3,3 0 1,0 10,10 Z M16,16 L12.5,12.5"
                Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Scan For Existing Junctions" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Discover manually created NTFS directory junctions in a folder."
                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Folder input -->
    <TextBlock Text="Directory to scan:" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FolderPathBox" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="10,0"/>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="8,0,0,0" Click="Browse_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0">
            <Path Data="M2,7 A2,2 0 0,1 4,5 H8 L10,7 H18 A2,2 0 0,1 20,9 M2,10 H22 L20,20 H4 L2,10 Z"
                  Stroke="{DynamicResource Text}" StrokeThickness="1.5" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock Text="Browse" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Quick Presets -->
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <TextBlock Text="Presets:" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button Content="%LocalAppData%" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="11" Click="PresetLocalAppData_Click"/>
      <Button Content="%AppData%" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="11" Click="PresetAppData_Click"/>
      <Button Content="User Profile" Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="11" Click="PresetUserProfile_Click"/>
    </StackPanel>

    <!-- Options: Recursive Switch (auto-checked) -->
    <CheckBox x:Name="RecursiveBox" Style="{StaticResource Switch}"
              Content="Scan all child subfolders recursively"
              IsChecked="True" Margin="0,14,0,0"
              ToolTip="When checked, scans child directories recursively (excluding junctions themselves to prevent loops). When unchecked, only inspects immediate subfolders."/>

    <!-- Options: Skip System Compatibility Junctions (auto-checked) -->
    <CheckBox x:Name="SkipSystemBox" Style="{StaticResource Switch}"
              Content="Skip Windows system compatibility junctions"
              IsChecked="True" Margin="0,8,0,0"
              ToolTip="Filters out Windows legacy compatibility junctions (e.g. Application Data, History, Temporary Internet Files, Content.IE5) and imports only user-created junctions."/>

    <!-- Status & Progress -->
    <ProgressBar x:Name="ScanProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0"/>
    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

    <!-- Action Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Height="30" Padding="18,0" IsDefault="True" Click="StartScan_Click">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="12" Height="12" Margin="0,0,6,0">
            <Path Data="M10,10 A3,3 0 1,0 10,16 A3,3 0 1,0 10,10 Z M16,16 L12.5,12.5"
                  Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
          </Viewbox>
          <TextBlock x:Name="ScanButtonText" Text="Scan" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
