<Window x:Class="JunctionManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Junction Manager" Width="1050" Height="640" MinWidth="840" MinHeight="420"
    WindowStartupLocation="CenterScreen" Icon="app.ico"
    Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header Row -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <!-- Left: Scan Pill + Search Filter -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Scan Pill Button -->
        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,10,0"
                ToolTip="Scan folder for existing junctions (e.g. AppData)" Click="Scan_Click">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
              <Path Data="M3,7 V5 A2,2 0 0,1 5,3 H7 M17,3 H19 A2,2 0 0,1 21,5 V7 M21,17 V19 A2,2 0 0,1 19,21 H17 M7,21 H5 A2,2 0 0,1 3,19 V17 M10,10 A3,3 0 1,0 10,16 A3,3 0 1,0 10,10 Z M16,16 L12.5,12.5"
                    Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="Scan" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
        </Button>

        <!-- Search Filter Box -->
        <Border Width="260" Height="32" CornerRadius="7" Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" SnapsToDevicePixels="True">
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Icon -->
            <Viewbox Width="13" Height="13" Margin="10,0,6,0">
              <Path Data="M10,10 A3,3 0 1,0 10,16 A3,3 0 1,0 10,10 Z M16,16 L12.5,12.5"
                    Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" Stretch="Uniform"/>
            </Viewbox>

            <!-- Text Input & Placeholder -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SearchPlaceholder" Text="Search junctions..." Foreground="{DynamicResource Muted}"
                         FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
              <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="2,0,0,0"
                       FontSize="12" VerticalContentAlignment="Center" CaretBrush="{DynamicResource Text}"
                       TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            </Grid>

            <!-- Clear Search Button -->
            <Button x:Name="SearchClearBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                    Width="20" Height="20" Margin="0,0,6,0" Visibility="Collapsed"
                    Click="SearchClear_Click" ToolTip="Clear search">
              <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Right: Theme Segmented Control + Info Button -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <!-- Theme Segmented Control (System, Light, Dark) -->
        <Border Background="{DynamicResource SegmentBg}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,8,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystemBtn" Style="{StaticResource ThemeSegmentButton}"
                         ToolTip="System default theme" Tag="System" Click="ThemeRadio_Click">
              <Path Data="M 2,2.5 H 14 A 1.5,1.5 0 0 1 15.5,4 V 10.5 A 1.5,1.5 0 0 1 14,12 H 2 A 1.5,1.5 0 0 1 0.5,10.5 V 4 A 1.5,1.5 0 0 1 2,2.5 Z M 8,12 V 14.5 M 5,14.5 H 11"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform"/>
            </RadioButton>
            <RadioButton x:Name="ThemeLightBtn" Style="{StaticResource ThemeSegmentButton}"
                         ToolTip="Light theme" Tag="Light" Click="ThemeRadio_Click">
              <Path Data="M7.5,4.5 A3,3 0 1,1 7.5,10.5 A3,3 0 1,1 7.5,4.5 M7.5,0.8 V2.6 M7.5,12.4 V14.2 M0.8,7.5 H2.6 M12.4,7.5 H14.2 M2.8,2.8 L4.1,4.1 M12.2,2.8 L10.9,4.1 M2.8,12.2 L4.1,10.9 M12.2,12.2 L10.9,10.9"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform"/>
            </RadioButton>
            <RadioButton x:Name="ThemeDarkBtn" Style="{StaticResource ThemeSegmentButton}"
                         ToolTip="Dark theme" Tag="Dark" Click="ThemeRadio_Click">
              <Path Data="M21 12.79 A9 9 0 1 1 11.21 3 A7 7 0 0 0 21 12.79 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                    Width="14" Height="14" Stretch="Uniform"/>
            </RadioButton>
          </StackPanel>
        </Border>

        <!-- About Button -->
        <Button Style="{StaticResource IconButton}" VerticalAlignment="Center"
                ToolTip="About Junction Manager" Click="About_Click">
          <Path Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 1,1 4,12A8,8 0 0,1 12,4M11,7H13V9H11V7M11,11H13V17H11V11Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Width="18" Height="18" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Column Headers -->
    <Grid Grid.Row="1" Margin="17,0,17,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="65"/><ColumnDefinition Width="105"/><ColumnDefinition Width="195"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Name" Foreground="{DynamicResource Muted}"/>
      <TextBlock Grid.Column="1" Text="Source (link)" Foreground="{DynamicResource Muted}"/>
      <TextBlock Grid.Column="2" Text="Target (real folder)" Foreground="{DynamicResource Muted}"/>
      <TextBlock Grid.Column="3" Text="Watch" Foreground="{DynamicResource Muted}"/>
      <TextBlock Grid.Column="4" Text="Status" Foreground="{DynamicResource Muted}"/>
    </Grid>

    <!-- Junction List -->
    <Grid Grid.Row="2">
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RowItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="65"/><ColumnDefinition Width="105"/><ColumnDefinition Width="195"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
              <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Source}"/>
              <TextBlock Grid.Column="2" Text="{Binding Target}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Target}"/>
              <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Watch}" VerticalAlignment="Center"
                        ToolTip="Watch and auto-repair after updates"/>
              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Status}"/>
              </StackPanel>
              <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource HiddenPillButton}" Margin="0,0,4,0"
                        ToolTip="{Binding HiddenToolTip}" Click="ToggleHidden_Click"/>
                <Button Style="{StaticResource ProtectedPillButton}" Margin="0,0,4,0"
                        ToolTip="{Binding ProtectedToolTip}" Click="ToggleProtected_Click"/>
                <Button Style="{StaticResource RowRepairButton}" Margin="0,0,4,0"
                        ToolTip="Repair junction link" Click="RowRepair_Click"/>
                <Button Style="{StaticResource RowOpenButton}" Margin="0,0,4,0"
                        ToolTip="Open target folder in File Explorer" Click="RowOpen_Click"/>
                <Button Style="{StaticResource RowDismissButton}" Margin="0,0,4,0"
                        ToolTip="Remove from list only (keeps link and files intact on disk)" Click="RowDismiss_Click"/>
                <Button Style="{StaticResource RowRemoveButton}"
                        ToolTip="Delete junction link (removes NTFS junction from disk)" Click="RowRemove_Click"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyStateText" Text="No junctions yet. Click New junction to add one." Foreground="{DynamicResource Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasItems, ElementName=List}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- Progress Card -->
    <Border Grid.Row="3" x:Name="ProgressCard" Visibility="Collapsed" Opacity="0" Margin="0,8,0,0" Padding="16"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <Grid>
          <TextBlock x:Name="PTitle" FontWeight="SemiBold"/>
          <TextBlock x:Name="PPct" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold"/>
        </Grid>
        <ProgressBar x:Name="PBar" Minimum="0" Maximum="100" Margin="0,10"/>
        <TextBlock x:Name="PText" Foreground="{DynamicResource Muted}" FontSize="12"/>
      </StackPanel>
    </Border>

    <!-- Options & Summary Row -->
    <Grid Grid.Row="4" Margin="0,12,0,8">
      <CheckBox x:Name="TrayCloseBox" Style="{StaticResource Switch}"
                Content="Keep running in system tray on close (watches junctions in background)"
                VerticalAlignment="Center"
                ToolTip="When checked, closing the window will minimize to the hidden taskbar icons tray instead of shutting down, keeping watched junctions auto-repaired."
                Checked="TrayCloseBox_Changed" Unchecked="TrayCloseBox_Changed"/>
      <TextBlock x:Name="Summary" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    </Grid>

    <!-- Action Buttons Row -->
    <Grid Grid.Row="5" Margin="0,4,0,0">
      <StackPanel x:Name="ActionButtons" Orientation="Horizontal">
        <Button Style="{StaticResource AccentButton}" Click="New_Click" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
              <Path Data="M12,4 V20 M4,12 H20" Stroke="White" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="New junction" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Click="RepairAll_Click" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
              <Path Data="M14.7,6.3 A1,1 0 0,0 14.7,7.7 L16.3,9.3 A1,1 0 0,0 17.7,9.3 L21.47,5.53 A6,6 0 0,1 13.53,13.47 L6.62,20.38 A2.12,2.12 0 0,1 3.62,17.38 L10.53,10.47 A6,6 0 0,1 18.47,2.53 L14.7,6.3 Z"
                    Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="Repair all" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
              <Path Data="M21.5,2 V8 H15.5 M21.34,15.57 A10,10 0 1,1 20.77,7.19 L21.5,8"
                    Stroke="{DynamicResource Text}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="Refresh" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Click="ClearAll_Click">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="13" Height="13" Margin="0,0,8,0">
              <Path Data="M3,6 H21 M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 M8,6 V4 A2,2 0 0,1 10,2 H14 A2,2 0 0,1 16,4 V6"
                    Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="Clear list" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Floating In-App Toast Notification -->
    <Border x:Name="ToastContainer" Grid.Row="0" Grid.RowSpan="6"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="14,8" MaxWidth="540"
            Opacity="0" Visibility="Collapsed" Panel.ZIndex="1000">
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.32"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="ToastTransform" Y="-16"/>
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Icon -->
        <Border x:Name="ToastIconBg" Width="22" Height="22" CornerRadius="11" Background="#10B981" Margin="0,0,10,0" VerticalAlignment="Center">
          <Path x:Name="ToastIconPath" Data="M4,11 L8,15 L16,7" Stroke="White" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <!-- Message Text -->
        <TextBlock x:Name="ToastMessage" Grid.Column="1" Text="Notification message" VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420"
                   Foreground="{DynamicResource Text}"/>
        <!-- Dismiss Button -->
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="10,0,0,0"
                VerticalAlignment="Center" Click="ToastDismiss_Click" ToolTip="Dismiss">
          <Path Data="M3,3 L11,11 M11,3 L3,11" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
                StrokeStartLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
